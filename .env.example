# Copy to .env (never commit the real file) and fill in.
# JWT signing secret: at least 32 chars. Generate with:  openssl rand -base64 48
JWT_SECRET=
# MongoDB credentials used by docker-compose
MONGO_USER=lifestyle
MONGO_PASSWORD=
# Optional: enables the Claude-powered shopping assistant. Without it a keyword recommender is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
